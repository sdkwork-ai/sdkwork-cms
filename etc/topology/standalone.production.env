VITE_SDKWORK_CMS_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:8080
SDKWORK_CMS_PC_STATIC_ROOT=/usr/share/sdkwork/cms/web/pc
SDKWORK_CORS_ALLOWED_ORIGINS=https://cms.sdkwork.com,https://cms.birdcoder.com,https://cms.dtupay.com,https://cms.noaper.com,https://cms.sdkwork.cn,https://cms.birdcoder.cn,https://cms.dtupay.cn,https://cms.noaper.cn,https://cms.skubc.com,https://cms.skubc.cn,https://cms.zowalk.com,https://cms.zowalk.cn,https://cms.offer86.com,https://cms.offer86.cn,https://cms.86offer.com,https://cms.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
