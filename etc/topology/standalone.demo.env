# standalone.demo — independent demonstration deployment, fully isolated from dev/test/staging/prod.
# Dedicated demo PostgreSQL schema/database `sdkwork_cms_demo` (DB identity).
# Redis isolation: any cache/rate-limit keys use a dedicated logical DB index so no key collides
# with another shared-redis environment. This profile declares no concrete redis/database env keys;
# provisioning must assign them before activation.
SDKWORK_CMS_DEPLOYMENT_PROFILE=standalone
SDKWORK_CMS_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_CMS_PROFILE_ID=standalone.demo
SDKWORK_CMS_APPLICATION_PUBLIC_HTTP_URL=https://cms-demo.sdkwork.com
SDKWORK_CMS_WEB_DEV_INGRESS_BIND=127.0.0.1:5333
SDKWORK_CMS_PC_INTERNAL_DEV_PORT=5335
SDKWORK_CMS_H5_INTERNAL_DEV_PORT=5336
SDKWORK_CMS_APPLICATION_PUBLIC_INGRESS_BIND=127.0.0.1:8080
VITE_SDKWORK_CMS_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:8080


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_CMS_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN
SDKWORK_CORS_ALLOWED_ORIGINS=https://cms-demo.sdkwork.com,http://cms-demo.sdkwork.com,https://cms-demo.birdcoder.com,http://cms-demo.birdcoder.com,https://cms-demo.dtupay.com,http://cms-demo.dtupay.com,https://cms-demo.noaper.com,http://cms-demo.noaper.com,https://cms-demo.sdkwork.cn,http://cms-demo.sdkwork.cn,https://cms-demo.birdcoder.cn,http://cms-demo.birdcoder.cn,https://cms-demo.dtupay.cn,http://cms-demo.dtupay.cn,https://cms-demo.noaper.cn,http://cms-demo.noaper.cn,https://cms-demo.skubc.com,http://cms-demo.skubc.com,https://cms-demo.skubc.cn,http://cms-demo.skubc.cn,https://cms-demo.zowalk.com,http://cms-demo.zowalk.com,https://cms-demo.zowalk.cn,http://cms-demo.zowalk.cn,https://cms-demo.offer86.com,http://cms-demo.offer86.com,https://cms-demo.offer86.cn,http://cms-demo.offer86.cn,https://cms-demo.86offer.com,http://cms-demo.86offer.com,https://cms-demo.86offer.cn,http://cms-demo.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
