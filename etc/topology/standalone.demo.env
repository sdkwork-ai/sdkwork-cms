# standalone.demo — independent demonstration deployment, fully isolated from dev/test/staging/prod.
# Dedicated demo PostgreSQL schema/database `sdkwork_cms_demo` (DB identity).
# Redis isolation: any cache/rate-limit keys use a dedicated logical DB index so no key collides
# with another shared-redis environment. This profile declares no concrete redis/database env keys;
# provisioning must assign them before activation.
SDKWORK_CMS_DEPLOYMENT_PROFILE=standalone
SDKWORK_CMS_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_CMS_PROFILE_ID=standalone.demo
SDKWORK_CMS_APPLICATION_PUBLIC_HTTP_URL=https://cms-demo.sdkwork.com
SDKWORK_CMS_WEB_DEV_INGRESS_BIND=127.0.0.1:5333
SDKWORK_CMS_PC_INTERNAL_DEV_PORT=5335
SDKWORK_CMS_H5_INTERNAL_DEV_PORT=5336
SDKWORK_CMS_APPLICATION_PUBLIC_INGRESS_BIND=127.0.0.1:8080
VITE_SDKWORK_CMS_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:8080
