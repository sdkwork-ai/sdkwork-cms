# cloud.development
SDKWORK_CMS_DEPLOYMENT_PROFILE=cloud
SDKWORK_CMS_ENVIRONMENT=development
SDKWORK_CMS_PROFILE_ID=cloud.development
SDKWORK_CMS_PLATFORM_API_GATEWAY_HTTP_URL=https://api.sdkwork.com
SDKWORK_CMS_APPLICATION_PUBLIC_HTTP_URL=https://api.sdkwork.com
VITE_SDKWORK_CMS_APPLICATION_PUBLIC_HTTP_URL=https://api.sdkwork.com
VITE_SDKWORK_CMS_PLATFORM_API_GATEWAY_HTTP_URL=https://api.sdkwork.com

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_CMS_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN
SDKWORK_CMS_WEB_DEV_INGRESS_BIND=127.0.0.1:5333
SDKWORK_CMS_PC_INTERNAL_DEV_PORT=5335
SDKWORK_CMS_H5_INTERNAL_DEV_PORT=5336


# dev:cloud local debugging override (vite dev surface only; PNPM_SCRIPT_SPEC section 3).
# The domain edges above stay authoritative for cloud-mode builds and deployed
# services. The development runtime instead binds every gateway-attached base
# URL to the sdkwork-api-cloud-gateway started by its own dev command
# (bind 127.0.0.1:3900), so dev:cloud quick-starts and debugs against the
# local gateway process.
SDKWORK_LOCAL_PLATFORM_API_GATEWAY_HTTP_URL=http://127.0.0.1:3900
SDKWORK_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5333,http://localhost:5333,https://cms-dev.sdkwork.com,http://cms-dev.sdkwork.com,https://cms-dev.birdcoder.com,http://cms-dev.birdcoder.com,https://cms-dev.dtupay.com,http://cms-dev.dtupay.com,https://cms-dev.noaper.com,http://cms-dev.noaper.com,https://cms-dev.sdkwork.cn,http://cms-dev.sdkwork.cn,https://cms-dev.birdcoder.cn,http://cms-dev.birdcoder.cn,https://cms-dev.dtupay.cn,http://cms-dev.dtupay.cn,https://cms-dev.noaper.cn,http://cms-dev.noaper.cn,https://cms-dev.skubc.com,http://cms-dev.skubc.com,https://cms-dev.skubc.cn,http://cms-dev.skubc.cn,https://cms-dev.zowalk.com,http://cms-dev.zowalk.com,https://cms-dev.zowalk.cn,http://cms-dev.zowalk.cn,https://cms-dev.offer86.com,http://cms-dev.offer86.com,https://cms-dev.offer86.cn,http://cms-dev.offer86.cn,https://cms-dev.86offer.com,http://cms-dev.86offer.com,https://cms-dev.86offer.cn,http://cms-dev.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
